{
    "name": "xit",
    "displayName": "xit!",
    "description": "Language support for todo lists with xit syntax.",
    "version": "0.1.0",
    "publisher": "emrikol",
    "license": "MIT",
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/emrikol/xit-vscode.git"
    },
    "homepage": "https://github.com/emrikol/xit-vscode#readme",
    "bugs": {
        "url": "https://github.com/emrikol/xit-vscode"
    },
    "qna": false,
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "xit",
        "todo",
        "task list",
        "checklist",
        "plain text",
        "productivity"
    ],
    "main": "./dist/extension.js",
    "browser": "./dist/web/extension.js",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "tsc",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write",
        "build": "npm run compile && node scripts/build.mjs",
        "package": "npm run compile && node scripts/build.mjs --production",
        "watch": "node scripts/build.mjs --watch",
        "icons": "sh scripts/render-icons.sh",
        "verify:injection": "node scripts/verify-markdown-injection.mjs",
        "corpus": "node scripts/fetch-corpus.mjs",
        "corpus:check": "node scripts/fetch-corpus.mjs --check",
        "open-web": "npm run build && vscode-test-web --browser none --quality stable --extensionDevelopmentPath=. test/fixtures",
        "open-web:demo": "npm run build && vscode-test-web --browser none --quality stable --extensionDevelopmentPath=. demo",
        "test": "npm run build && node --test \"test/**/*.test.mjs\"",
        "test:web": "npm run build && vscode-test-web --headless --quality stable --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/index.js demo",
        "test:integration": "npm run compile && vscode-test",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.6",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.43",
        "@types/vscode": "~1.75.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/test-web": "^0.0.81",
        "assert": "^2.1.0",
        "esbuild": "^0.28.1",
        "mocha": "^11.7.6",
        "process": "^0.11.10",
        "typescript": "^7.0.2",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "activationEvents": [
        "onLanguage:xit",
        "workspaceContains:**/*.xit"
    ],
    "contributes": {
        "configuration": {
            "title": "xit!",
            "properties": {
                "xit.overdueDueDates": {
                    "type": "boolean",
                    "default": true,
                    "description": "Mark due dates whose period has passed. A month, quarter, week or year counts as passed only once it has ended, so \"-> 2026\" is overdue on 1 January 2027."
                },
                "xit.overdueDueDateStyle": {
                    "type": "string",
                    "enum": [
                        "border-and-background",
                        "background",
                        "border",
                        "underline"
                    ],
                    "enumDescriptions": [
                        "A filled badge with a border around it.",
                        "A filled badge.",
                        "An outline around the date, leaving the theme’s own colour for the text.",
                        "An underline beneath the date, leaving the theme’s own colour for the text."
                    ],
                    "default": "border-and-background",
                    "description": "How an overdue due date is marked. The filled styles also set the text colour, because a background that leaves the theme choosing the text colour pairs two colours that have never met."
                },
                "xit.criticallyOverdueAfterDays": {
                    "type": "number",
                    "default": 14,
                    "minimum": 0,
                    "description": "Days past the end of its period before a due date is marked critically overdue, in a second colour. Set to 0 to use one colour for everything."
                },
                "xit.autoCheckParents": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check an item automatically once all of its subtasks are checked, and uncheck it again when one is reopened. Only moves an item between open and checked; an ongoing, obsolete or in-question item is left as it is."
                },
                "xit.stampCompletionDate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Record when an item was completed, as a tag on its first line. Removed again if the item is reopened. A tag rather than new syntax, because syntax is for what you author and tags are for what the editor records."
                },
                "xit.completionDateTag": {
                    "type": "string",
                    "default": "done",
                    "description": "Name of the tag used to record a completion date. Must be a valid tag name: letters, digits, underscore or hyphen."
                },
                "xit.stampCreationDate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Record when an item was created, as a tag, when you finish typing its checkbox. Deliberately narrow: a pasted block is not stamped, and neither is undo or redo, because a wrong date is worse than no date. With the completion date, an item records its own cycle time."
                },
                "xit.creationDateTag": {
                    "type": "string",
                    "default": "created",
                    "description": "Name of the tag used to record a creation date. Must be a valid tag name: letters, digits, underscore or hyphen."
                },
                "xit.repeatItems": {
                    "type": "boolean",
                    "default": true,
                    "description": "When a checked item carries a repeat tag, insert its next occurrence below. The tag is the opt-in, so this only affects items that have one."
                },
                "xit.repeatTag": {
                    "type": "string",
                    "default": "repeat",
                    "description": "Name of the tag that marks a repeating item. Its value is an interval: daily, weekly, monthly, quarterly, yearly, weekdays, a named day such as monday, or a count such as 3d, 2w or 6m. Prefix it with + — +7d — to count from the day the item was checked rather than from its due date."
                },
                "xit.diagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Report problems the syntax highlighting cannot show: a due date the calendar does not have, something shaped like a checkbox that is not one, a line that is not an item, a title or a comment, an indent that cannot nest, a comment that is never closed, and the four places the format disregards what you wrote without saying so — a second due date, a tag value whose quote never closes, exclamation marks that do not form a priority, a value one of this fork’s own tags cannot read, a directive that does nothing, and an item that cannot begin until after it is due."
                },
                "xit.dueSoonWithinDays": {
                    "type": "number",
                    "default": 7,
                    "minimum": 0,
                    "description": "Days ahead within which a due date counts as due soon, in the workspace view."
                },
                "xit.overdueInStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a count of overdue items in the status bar. It says nothing when nothing is overdue, so a quiet workspace costs no space."
                },
                "xit.archiveTitle": {
                    "type": "string",
                    "default": "Archive",
                    "description": "Title of the group finished items are moved under, at the end of the file."
                },
                "xit.estimateTag": {
                    "type": "string",
                    "default": "est",
                    "description": "Name of the tag that carries a time estimate. Its value is a number and a unit: 30m, 2h, 1.5h, 1d or 1w. A day is eight hours and a week is five days, which only affects how totals read."
                },
                "xit.alignPriorities": {
                    "type": "boolean",
                    "default": false,
                    "description": "Draw priority marks in a column, aligned within each group. Nothing is inserted into the file — the padding is a decoration, so it disappears with this setting. Off by default: Sort Group answers \"which is most urgent\" definitively, and a column only helps you eyeball it."
                },
                "xit.itemGrouping": {
                    "type": "string",
                    "enum": [
                        "urgency",
                        "tag"
                    ],
                    "enumDescriptions": [
                        "Group by how late each item is, worst first.",
                        "Group by tag, ranked by urgency inside each one. An item with two tags appears under both."
                    ],
                    "default": "urgency",
                    "description": "How the Items panel arranges its top level. Group Items by Tag switches it for the session without changing this."
                }
            }
        },
        "configurationDefaults": {
            "[xit]": {
                "editor.insertSpaces": false,
                "editor.tabSize": 4
            }
        },
        "colors": [
            {
                "id": "xit.overdueDueDateBackground",
                "description": "Background of an overdue due date.",
                "defaults": {
                    "dark": "#E5A000",
                    "light": "#8A6100",
                    "highContrast": "#E5A000",
                    "highContrastLight": "#8A6100"
                }
            },
            {
                "id": "xit.overdueDueDateForeground",
                "description": "Text colour of an overdue due date, used whenever a background is drawn behind it.",
                "defaults": {
                    "dark": "#000000",
                    "light": "#FFFFFF",
                    "highContrast": "#000000",
                    "highContrastLight": "#FFFFFF"
                }
            },
            {
                "id": "xit.overdueDueDateBorder",
                "description": "Border or underline of an overdue due date.",
                "defaults": {
                    "dark": "#E5A000",
                    "light": "#8A6100",
                    "highContrast": "#E5A000",
                    "highContrastLight": "#8A6100"
                }
            },
            {
                "id": "xit.criticallyOverdueDueDateBackground",
                "description": "Background of a due date that is critically overdue.",
                "defaults": {
                    "dark": "#F14C4C",
                    "light": "#A31515",
                    "highContrast": "#F14C4C",
                    "highContrastLight": "#A31515"
                }
            },
            {
                "id": "xit.criticallyOverdueDueDateForeground",
                "description": "Text colour of a critically overdue due date, used whenever a background is drawn behind it.",
                "defaults": {
                    "dark": "#000000",
                    "light": "#FFFFFF",
                    "highContrast": "#000000",
                    "highContrastLight": "#FFFFFF"
                }
            },
            {
                "id": "xit.criticallyOverdueDueDateBorder",
                "description": "Border or underline of a critically overdue due date.",
                "defaults": {
                    "dark": "#F14C4C",
                    "light": "#A31515",
                    "highContrast": "#F14C4C",
                    "highContrastLight": "#A31515"
                }
            }
        ],
        "languages": [
            {
                "id": "xit",
                "aliases": [
                    "xit!",
                    "xit"
                ],
                "extensions": [
                    ".xit"
                ],
                "firstLine": "^\\[[ x@~?]\\](\\s|$)",
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/file-icon-light.png",
                    "dark": "./assets/file-icon-dark.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "xit",
                "scopeName": "source.xit",
                "path": "./syntaxes/xit.tmLanguage.json"
            },
            {
                "scopeName": "markdown.xit.codeblock",
                "path": "./syntaxes/xit.markdown.tmLanguage.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.xit": "xit"
                }
            }
        ],
        "keybindings": [
            {
                "command": "xit.suggest",
                "key": "ctrl+space",
                "when": "editorFocus && editorLangId == 'xit'"
            },
            {
                "command": "xit.toggle",
                "key": "ctrl+alt+x",
                "when": "editorFocus && editorLangId == 'xit'"
            },
            {
                "command": "xit.shuffle",
                "key": "ctrl+alt+d",
                "when": "editorFocus && editorLangId == 'xit'"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "xit.suggest",
                    "when": "false"
                },
                {
                    "command": "xit.toggle",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.shuffle",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.refreshItems",
                    "when": "xit.hasItems"
                },
                {
                    "command": "xit.toggleDoneItems",
                    "when": "xit.hasItems"
                },
                {
                    "command": "xit.filterItemsByTag",
                    "when": "xit.hasItems"
                },
                {
                    "command": "xit.clearItemFilter",
                    "when": "xit.filteringByTag"
                },
                {
                    "command": "xit.toggleItemGrouping",
                    "when": "xit.hasItems"
                },
                {
                    "command": "xit.migrate",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.postpone",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.sortGroup",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.archive",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.giveId",
                    "when": "editorLangId == 'xit'"
                }
            ],
            "view/title": [
                {
                    "command": "xit.filterItemsByTag",
                    "when": "view == xit.items",
                    "group": "navigation@1"
                },
                {
                    "command": "xit.clearItemFilter",
                    "when": "view == xit.items && xit.filteringByTag",
                    "group": "navigation@2"
                },
                {
                    "command": "xit.toggleItemGrouping",
                    "when": "view == xit.items",
                    "group": "navigation@3"
                },
                {
                    "command": "xit.toggleDoneItems",
                    "when": "view == xit.items",
                    "group": "navigation@4"
                },
                {
                    "command": "xit.refreshItems",
                    "when": "view == xit.items",
                    "group": "navigation@5"
                }
            ]
        },
        "commands": [
            {
                "title": "Suggest (internal)",
                "command": "xit.suggest"
            },
            {
                "title": "Toggle Checkbox",
                "command": "xit.toggle"
            },
            {
                "title": "Shuffle Checkbox State",
                "command": "xit.shuffle"
            },
            {
                "command": "xit.refreshItems",
                "title": "Refresh",
                "category": "xit!",
                "icon": "$(refresh)"
            },
            {
                "command": "xit.toggleDoneItems",
                "title": "Show Completed Items",
                "category": "xit!",
                "icon": "$(check-all)"
            },
            {
                "command": "xit.filterItemsByTag",
                "title": "Filter Items by Tag",
                "category": "xit!",
                "icon": "$(filter)"
            },
            {
                "command": "xit.clearItemFilter",
                "title": "Clear Tag Filter",
                "category": "xit!",
                "icon": "$(clear-all)"
            },
            {
                "command": "xit.toggleItemGrouping",
                "title": "Group Items by Tag",
                "category": "xit!",
                "icon": "$(list-tree)"
            },
            {
                "title": "Migrate to the Current Format",
                "command": "xit.migrate",
                "category": "xit!"
            },
            {
                "command": "xit.postpone",
                "title": "Postpone",
                "category": "xit!"
            },
            {
                "command": "xit.sortGroup",
                "title": "Sort Group",
                "category": "xit!"
            },
            {
                "command": "xit.archive",
                "title": "Archive Finished Items",
                "category": "xit!"
            },
            {
                "command": "xit.giveId",
                "title": "Give This Item an Id",
                "category": "xit!"
            }
        ],
        "snippets": [
            {
                "language": "xit",
                "path": "./snippets.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "xit",
                    "title": "[x]it!",
                    "icon": "assets/activity-bar.svg"
                }
            ]
        },
        "views": {
            "xit": [
                {
                    "id": "xit.items",
                    "name": "Items",
                    "when": "xit.hasItems",
                    "icon": "assets/activity-bar.svg"
                }
            ]
        }
    }
}
