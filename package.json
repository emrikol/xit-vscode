{
    "name": "xit",
    "displayName": "xit!",
    "description": "Language support for todo lists with xit syntax.",
    "version": "0.0.5",
    "publisher": "tscpp",
    "license": "MIT",
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/emrikol/xit-vscode.git"
    },
    "homepage": "https://github.com/emrikol/xit-vscode#readme",
    "bugs": {
        "url": "https://github.com/emrikol/xit-vscode"
    },
    "qna": false,
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "xit",
        "todo",
        "task list",
        "checklist",
        "plain text",
        "productivity"
    ],
    "main": "./dist/extension.js",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc",
        "watch": "tsc -w",
        "icons": "sh scripts/render-icons.sh",
        "test": "npm run build && node --test \"test/**/*.test.mjs\"",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "~1.75.0",
        "typescript": "^7.0.2",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "contributes": {
        "languages": [
            {
                "id": "xit",
                "aliases": [
                    "xit!",
                    "xit"
                ],
                "extensions": [
                    ".xit"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/file-icon-light.png",
                    "dark": "./assets/file-icon-dark.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "xit",
                "scopeName": "source.xit",
                "path": "./syntaxes/xit.tmLanguage.json"
            }
        ],
        "keybindings": [
            {
                "command": "xit.suggest",
                "key": "ctrl+space",
                "when": "editorFocus && editorLangId == 'xit'"
            },
            {
                "command": "xit.toggle",
                "key": "ctrl+alt+x",
                "when": "editorFocus && editorLangId == 'xit'"
            },
            {
                "command": "xit.shuffle",
                "key": "ctrl+alt+d",
                "when": "editorFocus && editorLangId == 'xit'"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "xit.suggest",
                    "when": "false"
                },
                {
                    "command": "xit.toggle",
                    "when": "editorLangId == 'xit'"
                },
                {
                    "command": "xit.shuffle",
                    "when": "editorLangId == 'xit'"
                }
            ]
        },
        "commands": [
            {
                "title": "Suggest (internal)",
                "command": "xit.suggest"
            },
            {
                "title": "Toggle Checkbox",
                "command": "xit.toggle"
            },
            {
                "title": "Shuffle Checkbox State",
                "command": "xit.shuffle"
            }
        ],
        "snippets": [
            {
                "language": "xit",
                "path": "./snippets.json"
            }
        ]
    }
}
