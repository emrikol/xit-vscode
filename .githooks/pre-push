#!/bin/sh
#
# Last gate before anything leaves the machine: the unit tests, the
# integration tests, then a packaging check.
#
# The integration tests launch a real VS Code and take a few seconds, which is
# why they are here and not on the pre-commit hook. They earn it: they caught
# a test that assumed opening an xit file activates the extension, which it
# does not and should not.
#
# The packaging check earns its place too. Manifest mistakes are invisible to
# the test suite and to the compiler, and you only meet them at publish time.
# It is what caught .claude/settings.local.json being bundled into the vsix.
#
# Needs network the first time: vsce, and a ~300 MB VS Code download that is
# then cached in .vscode-test/.
#
# Bypass with `git push --no-verify` when you need to.

set -e

# `mktemp -d` with no template is the one form both BSD and GNU mktemp
# accept. `mktemp -t prefix` is not portable: GNU rejects a template with no
# X's, and Homebrew's coreutils puts GNU mktemp ahead of the BSD one on PATH.
tmpdir=$(mktemp -d)
vsix="$tmpdir/xit.vsix"
log="$tmpdir/test.log"

cleanup() {
	rm -rf "$tmpdir"
}
trap cleanup EXIT

if ! npm test >"$log" 2>&1; then
	cat "$log" >&2
	echo >&2
	echo "pre-push: tests failed, push aborted." >&2
	echo "          fix them, or bypass with: git push --no-verify" >&2
	exit 1
fi

if ! npm run test:integration >"$log" 2>&1; then
	cat "$log" >&2
	echo >&2
	echo "pre-push: integration tests failed, push aborted." >&2
	echo "          fix them, or bypass with: git push --no-verify" >&2
	exit 1
fi

if ! npx --yes @vscode/vsce package --no-git-tag-version --out "$vsix" >/dev/null; then
	echo
	echo "pre-push: the extension failed to package, push aborted." >&2
	echo "          run it yourself to see why:" >&2
	echo "            npx @vscode/vsce package --no-git-tag-version --out /tmp/x.vsix" >&2
	echo "          or bypass with: git push --no-verify" >&2
	exit 1
fi

# Packaging succeeding is not the same as packaging the right thing. Read the
# file list back and refuse anything outside it. .vscodeignore is a deny list,
# so a new file in the repo lands in the vsix by default; this is the allow
# list that turns that around. It has already caught .claude/settings.local.json
# and .vscode-test.mjs.
unexpected=$(unzip -Z1 "$vsix" | grep -Ev \
	'^(\[Content_Types\]\.xml|extension\.vsixmanifest|extension/(package\.json|readme\.md|changelog\.md|LICENSE\.txt|language-configuration\.json|snippets\.json|assets/[a-z-]+\.png|dist/([a-z]+/)?extension\.js|syntaxes/[A-Za-z.]+\.json))$' \
	|| true)

if [ -n "$unexpected" ]; then
	echo >&2
	echo "pre-push: unexpected files in the vsix, push aborted." >&2
	echo "$unexpected" | sed 's/^/            /' >&2
	echo "          add them to .vscodeignore, or to the allow list in this hook." >&2
	exit 1
fi

echo "pre-push: unit and integration tests pass, and the extension packages clean."
