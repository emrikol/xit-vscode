{
    // comments occupy whole lines, so there is no line comment to toggle
    "comments": {
        "blockComment": ["<!--", "-->"]
    },
    // symbols used as brackets
    "brackets": [
        ["[", "]"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ]
}